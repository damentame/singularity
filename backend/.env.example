APP_NAME=singularity-backend
DEBUG=false
# For local dev: run `npx supabase start` and paste the API URL, anon key,
# and service_role key from its output.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<anon key from `npx supabase start` output>
SUPABASE_SERVICE_ROLE_KEY=<service_role key from `npx supabase start` output>
